/.pretrained_checkpoints/

# Vendored numpy 1.26 used only by scripts/rsl_rl/record.py (video recording): Isaac Sim's
# omni.graph numpy interop needs the numpy 1.x ABI. Built with pip --no-deps --target, so it is a
# reproducible artifact, not source. Keep it OUT of .dockerignore -- the cluster sync has to carry
# it; record.py rebuilds it with pip if a checkout does not have it.
/numpy_compat/

# Teleop Recorded Dataset
/datasets/

# Tests
tests/

# Docker history
.isaac-lab-docker-history

*.pyc
__pycache__/
